# Multi-stage Standalone Dockerfile for Remote Executor MCP (mcp-execmesh)
# Can be used directly with docker build on any machine without pre-compiling Go locally

FROM golang:1.24-alpine AS builder

WORKDIR /src

ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct \
    CGO_ENABLED=0 \
    GOOS=linux

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o /bin/remote-mcp ./cmd/remote-mcp

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -g 10001 -S mcpuser \
    && adduser -u 10001 -S -G mcpuser -h /var/lib/remote-mcp mcpuser \
    && mkdir -p /etc/remote-mcp /var/lib/remote-mcp /var/log/remote-mcp /etc/remote-mcp/secrets \
    && chown -R mcpuser:mcpuser /var/lib/remote-mcp /var/log/remote-mcp /etc/remote-mcp

COPY --from=builder /bin/remote-mcp /usr/local/bin/remote-mcp

USER 10001:10001
WORKDIR /var/lib/remote-mcp

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/remote-mcp"]
CMD ["-config", "/etc/remote-mcp/config.yaml"]
